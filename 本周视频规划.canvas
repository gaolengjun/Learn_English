		{"id":"12fe5fab754004e8","type":"text","text":"Hi, guys! Today, I want to show you about my belongings. This room is not my home, so my stuff is few.","x":-1060,"y":-400,"width":527,"height":67},
		{"id":"bf50965ec9f7497f","type":"text","text":"# 本周视频规划","x":-320,"y":-396,"width":250,"height":60},
